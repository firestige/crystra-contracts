{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/firestige/crystra-contracts/evaluation-2-candidate/generated/schemas/metric-catalog-2.0.0.schema.json",
  "title": "Evaluation Metric Catalog 2.0.0 review candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_id",
    "version",
    "status",
    "semantic_authority",
    "dependencies",
    "minimum_sample_policy",
    "coverage_policy",
    "input_definitions",
    "metrics"
  ],
  "properties": {
    "catalog_id": {
      "const": "agentops.evaluation.metric-catalog"
    },
    "version": {
      "const": "2.0.0"
    },
    "status": {
      "const": "REVIEW_CANDIDATE"
    },
    "semantic_authority": {
      "const": "crystra-contracts/docs/contracts/evaluation/metric-catalog-2-candidate.md@metric-catalog-2-candidate"
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coordinate",
          "status",
          "semantic_revision",
          "machine_revision",
          "input_binding_sha256"
        ],
        "properties": {
          "coordinate": {
            "const": "observation-profile@1.0.0"
          },
          "status": {
            "const": "CURRENT"
          },
          "semantic_revision": {
            "const": "sha256:fc8e2e3b91d3c498b7b7147884fa87d42a1cf8909322d504272d74e77b703fe2"
          },
          "machine_revision": {
            "const": "sha256:3ab481544a12c81c3a1ecea9f6b5f1323bf974b8e42b364bf1f57d14e726f5a6"
          },
          "input_binding_sha256": {
            "const": "ab3f217e63af63ace386e566d401c883117bb90b3b18dead19ff2bc2e60b37ff"
          }
        }
      }
    },
    "minimum_sample_policy": {
      "const": "below minimum_sample the metric value is not published; coverage numerator, denominator, raw ratio, state and alert are still published"
    },
    "coverage_policy": {
      "$ref": "#/definitions/coveragePolicy"
    },
    "input_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/inputDefinition"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/metric"
      }
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      },
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      },
      "uniqueItems": true
    },
    "inputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "source_layer",
        "semantic_ref",
        "binding"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^(observation|evaluation|projection)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "source_layer": {
          "enum": [
            "observation",
            "evaluation",
            "projection"
          ]
        },
        "semantic_ref": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "binding": {
          "const": "human-semantic-reference"
        }
      }
    },
    "coveragePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_fields",
        "states",
        "default_alert_threshold",
        "allowed_alert_thresholds",
        "low_coverage_rule",
        "publication_rule"
      ],
      "properties": {
        "result_fields": {
          "const": [
            "numerator",
            "denominator",
            "raw_ratio",
            "state",
            "alert"
          ]
        },
        "states": {
          "const": [
            "NO_POPULATION",
            "NO_COVERAGE",
            "PARTIAL",
            "FULL"
          ]
        },
        "default_alert_threshold": {
          "const": 0.1
        },
        "allowed_alert_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum_exclusive",
            "multiple_of"
          ],
          "properties": {
            "minimum": {
              "const": 0
            },
            "maximum_exclusive": {
              "const": 1
            },
            "multiple_of": {
              "const": 0.01
            }
          }
        },
        "low_coverage_rule": {
          "const": "threshold = 0 disables LOW_COVERAGE; otherwise denominator > 0 and 100 * numerator < threshold_hundredths * denominator"
        },
        "publication_rule": {
          "const": "coverage is always published and never gates publication or rewrites a computable metric value"
        }
      }
    },
    "coverageBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator",
        "numerator"
      ],
      "properties": {
        "denominator": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "numerator": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "valueSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "unit",
        "missing"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rate",
            "count",
            "duration",
            "quantity",
            "money"
          ]
        },
        "unit": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "missing": {
          "type": "string",
          "pattern": "^N/A when .+"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "version",
        "name",
        "status",
        "evaluation_unit",
        "value_semantics",
        "dimensions",
        "filters",
        "time_window",
        "calculation",
        "input_refs",
        "eligibility",
        "exclusions",
        "minimum_sample",
        "coverage",
        "uncertainty",
        "forbidden_inference",
        "owner"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "status": {
          "enum": [
            "implemented",
            "planned"
          ]
        },
        "evaluation_unit": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "value_semantics": {
          "$ref": "#/definitions/valueSemantics"
        },
        "dimensions": {
          "$ref": "#/definitions/uniqueStrings"
        },
        "filters": {
          "$ref": "#/definitions/uniqueStrings"
        },
        "time_window": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "calculation": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "input_refs": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "eligibility": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "exclusions": {
          "$ref": "#/definitions/uniqueStrings"
        },
        "minimum_sample": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "$ref": "#/definitions/coverageBasis"
        },
        "uncertainty": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "forbidden_inference": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "owner": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    }
  }
}
