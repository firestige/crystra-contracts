{
  "schemaVersion": "crystra.release-component@1.0.0",
  "repository": "firestige/crystra-contracts",
  "releaseBranch": "main",
  "triggerBranch": "release/next",
  "assetMode": "current-contract-resources",
  "acceptanceCommand": "node release/cli/qualify.cjs --install",
  "buildCommand": "node release/cli/release.cjs build",
  "verifyCommand": "node release/cli/release.cjs verify",
  "publisherAdapter": "current-contracts+github-release",
  "remoteInstallMode": "exact-current-resource-resolution",
  "stablePolicy": "qualified-candidate-exact-assets",
  "capabilities": [
    "github-release",
    "current-contract-resources"
  ]
}
